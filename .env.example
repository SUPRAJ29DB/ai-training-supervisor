# =====================================================================
# AI Training Supervisor - Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =====================================================================

# --- Application ---
APP_ENV=development          # development | production
SECRET_KEY=change-me-to-a-random-string

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Dashboard ---
DASHBOARD_PORT=8501

# --- Database ---
DATABASE_URL=sqlite:///./data/supervisor.db

# --- LLM / Raspberry Pi ---
LLM_ENABLED=false
LLM_HOST=192.168.1.100
LLM_PORT=11434
LLM_MODEL=mistral

# --- Email Notifications (optional) ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_RECIPIENTS=

# --- GPU ---
CUDA_VISIBLE_DEVICES=0
